# Environment Variables - Copy to .env.local and fill in your values

# Google Analytics
NEXT_PUBLIC_GA_ID=G_YOUR_GA_ID_HERE

# Form Submission (Formspree)
# Get free form endpoint at https://formspree.io
NEXT_PUBLIC_FORMSPREE_ID=f_xxxxxxxxx

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# WhatsApp Business
# Your phone number with country code (e.g., 1234567890 for +1-234-567-890)
NEXT_PUBLIC_WHATSAPP_NUMBER=your_phone_number_here

# Instagram Username
NEXT_PUBLIC_INSTAGRAM_USERNAME=orpaulphotography

# Site Name
NEXT_PUBLIC_SITE_NAME=Or Paull Photography

# Contact Email
NEXT_PUBLIC_CONTACT_EMAIL=orchasson@gmail.com
